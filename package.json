{
  "name": "sikick-public-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sikick public marketing website — standalone project, independent from the IMS console repository.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@fontsource/noto-sans-devanagari": "^5.2.5",
    "@fontsource/noto-sans-telugu": "^5.2.5",
    "i18next": "^25.5.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "oxlint": "^1.18.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
