# Public URL of this website itself (used for canonical URLs, OG tags, sitemap).
VITE_SITE_URL=http://localhost:5173

# Deployed Sikick IMS console (browser app). Login is handled there —
# this website never implements authentication itself.
VITE_SIKICK_APP_URL=https://ims-web-902186518684.asia-south2.run.app

# Where the "Log in" CTA points. Defaults to the IMS console root,
# which shows the sign-in screen to signed-out visitors.
# VITE_SIKICK_LOGIN_URL=

# Where the "Start a 14-day trial" CTA points (the IMS signup flow).
# VITE_SIKICK_TRIAL_URL=

# Deployed POS terminal (separate repository/deployment).
VITE_SIKICK_POS_URL=https://pos-web-902186518684.asia-south2.run.app

# Optional backends for marketing-site forms. When unset, the forms show
# an honest "not yet configured" state — they never fake a success.
# POST endpoint that accepts the Enterprise quote request JSON.
# VITE_SIKICK_QUOTE_ENDPOINT=
# POST endpoint that accepts { email, consent, blueprintHtml } for blueprint email delivery.
# VITE_SIKICK_EMAIL_ENDPOINT=
# Public calendar-booking URL offered after a quote request.
# VITE_SIKICK_CALENDAR_URL=

# POST endpoint that accepts assisted-migration requests (falls back to the quote endpoint).
# VITE_SIKICK_MIGRATION_ENDPOINT=
